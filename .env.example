# Copiar a .env y completar. .env esta en .gitignore: nunca se commitea.
AIRFLOW_UID=50000
FERNET_KEY=<generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# SQL Server local (solo para crear la base y el login del laboratorio).
# Debe tener mayusculas, minusculas, numeros y simbolos (politica de SQL Server).
MSSQL_SA_PASSWORD=<password-sa>
# Password del login lab_user (debe coincidir con la de AIRFLOW_CONN_MSSQL_LAB)
MSSQL_LAB_PASSWORD=<password-lab-user>

# Conexion que usa el pipeline: login del laboratorio (nunca sa)
AIRFLOW_CONN_MSSQL_LAB='{"conn_type":"odbc","host":"sqlserver","port":1433,"schema":"labdb","login":"lab_user","password":"<password-lab-user>","extra":{"driver":"ODBC Driver 18 for SQL Server","TrustServerCertificate":"yes"}}'

# SMTP de prueba (Mailpit): es la que usa config/entornos/local.yaml
AIRFLOW_CONN_SMTP_MAILPIT='{"conn_type":"smtp","host":"mailpit","port":1025,"extra":{"disable_ssl":true,"disable_tls":true,"from_email":"airflow@lab.local"}}'

# Opcional: SMTP real (por ejemplo Gmail con app password, puerto 587 + STARTTLS)
AIRFLOW_CONN_SMTP_LAB='{"conn_type":"smtp","host":"smtp.gmail.com","port":587,"login":"<cuenta>","password":"<app-password>","extra":{"disable_ssl":true,"disable_tls":false,"from_email":"<cuenta>"}}'

# Opcional: pisa el destinatario de config/entornos/local.yaml
AIRFLOW_VAR_LAB_MAIL_DESTINATARIO=<destinatario@ejemplo.com>
